# Copy to .env and edit locally. Process environment overrides this file.
# Values are literal KEY=value; quote values containing #. No shell expansion.
DEBUG=true
ALLOWED_HOSTS=localhost,127.0.0.1,[::1]
# Generate your own stable random key; required when DEBUG=false.
SECRET_KEY=
CSRF_TRUSTED_ORIGINS=
# Optional absolute path; defaults to the existing project db.sqlite3.
# SQLITE_PATH=/absolute/path/to/db.sqlite3
EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=True
EMAIL_USE_SSL=False
EMAIL_TIMEOUT=15
DEFAULT_FROM_EMAIL=
# Gmail is one example; replace EMAIL_HOST/PORT/security settings for another provider.
# For Gmail, set EMAIL_HOST_USER and DEFAULT_FROM_EMAIL to your Gmail address.
# EMAIL_HOST_PASSWORD must be a provider-specific SMTP credential (a Google App Password
# for Gmail), entered locally. Never paste credentials into source files or logs.
# To intentionally disable real delivery for local work, set EMAIL_BACKEND to
# django.core.mail.backends.locmem.EmailBackend. Never use console mail in production.
PASSWORD_RESET_TIMEOUT=3600
EMAIL_VERIFICATION_TIMEOUT=86400
# Production: DEBUG=false, explicit hosts, HTTPS origins and a strong SECRET_KEY.
# Serve media/ and private_expense_files/ through authenticated Django routes ONLY.
# Enable only if the trusted proxy strips and sets X-Forwarded-Proto itself.
TRUST_PROXY_HTTPS=false
# Production defaults to one year; local DEBUG=true defaults to zero.
# SECURE_HSTS_SECONDS=31536000
SECURE_HSTS_INCLUDE_SUBDOMAINS=false
SECURE_HSTS_PRELOAD=false

# Selectable percentages, not an HSN/date-specific legal rate table. Review before use.
GST_ALLOWED_RATES=0,5,12,18,28,40

# Session security (server-enforced; values in seconds). See docs/acceptance/SESSION_SECURITY_HARDENING.md
SESSION_IDLE_TIMEOUT=1800
SESSION_ABSOLUTE_TIMEOUT=43200
SESSION_ACTIVITY_UPDATE_INTERVAL=60
SESSION_WARNING_SECONDS=120
# true = sign out when the browser closes (recommended on shared computers)
SESSION_EXPIRE_AT_BROWSER_CLOSE=false
