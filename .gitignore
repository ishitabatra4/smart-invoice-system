# ---------------------------------------------------------------
# Smart Invoice System — files that must never be committed
# ---------------------------------------------------------------

# Python caches
__pycache__/
*.py[cod]
*.pyo

# Virtual environments
env/
venv/
.venv/

# Environment variables and secrets (only the placeholder template is tracked)
.env
.env.*
!.env.example
*.pem
*.key

# SQLite databases, journals and database backups (contain financial/personal data)
db.sqlite3
db.sqlite3-journal
*.sqlite3
*.sqlite3-journal
*.sqlite3-wal
*.sqlite3-shm
db.backup*.sqlite3

# Verified backups and isolated demo environments (kept locally, never pushed)
.backups/
.demo/
.demo-archive-*/

# Private media and uploaded source documents
media/
private_expense_files/
staticfiles/

# Sensitive academic and personal documents and large generated archives
*.zip
*.docx

# Logs, temporary files and test artifacts
*.log
*.tmp
*.bak
*.swp
smart-invoice-test-media-*/
.coverage
htmlcov/
.pytest_cache/
node_modules/

# IDE and OS
.vscode/
.idea/
.DS_Store
